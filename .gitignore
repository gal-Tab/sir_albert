
# Knowledge base — extracted files (regenerated from raw sources)
raw/.extracted/

# Knowledge base — binary source files (avoid bloating git history)
raw/*.pdf
raw/*.epub
raw/*.docx
raw/*.xlsx
raw/*.pptx

# Python cache
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
**/.DS_Store
.idea/
.pytest_cache/

